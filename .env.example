# All optional. The app runs fully offline with none of these set.

# Storage. With both set, every collection reads and writes Supabase instead of
# the JSON files in data/. With either missing, the file store is used, so a
# fresh clone still runs with no configuration at all.
#
# The service role key bypasses RLS and must never reach the browser — it is
# only ever read server-side in lib/db/store.ts. Never commit a real value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Switches syllabus generation, lesson authoring and the tutor over to the
# model. Without it, content comes from lib/courses/packs and the tutor
# returns a scripted reply.
OPENAI_API_KEY=

# Defaults to gpt-5.4.
# OPENAI_MODEL=gpt-5.4

# Defaults to gpt-4o-transcribe.
# OPENAI_TRANSCRIBE_MODEL=

# Text-to-speech for the study buddy. Used for its character-level alignment,
# which drives the orb's lip sync (lib/tutor/voice.ts). Without it the buddy
# replies in text.
ELEVENLABS_API_KEY=

# Defaults to 21m00Tcm4TlvDq8ikWAM (Rachel).
# ELEVENLABS_VOICE_ID=

# Defaults to eleven_turbo_v2_5.
# ELEVENLABS_MODEL_ID=
